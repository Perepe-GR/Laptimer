name: Build APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Descomprimir proyecto
        run: unzip -q laptimer-v2.zip

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"

      - name: Compilar APK
        working-directory: laptimer-v2
        run: gradle assembleDebug --no-daemon

      - name: Copiar APK
        run: cp laptimer-v2/app/build/outputs/apk/debug/app-debug.apk laptimer-v2.apk

      - uses: actions/upload-artifact@v4
        with:
          name: laptimer-apk
          path: laptimer-v2.apk

      - name: Publicar en Releases
        uses: softprops/action-gh-release@v2
        with:
          tag_name: apk-latest
          name: APK más reciente
          prerelease: true
          files: laptimer-v2.apk
